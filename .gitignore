# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 环境变量 —— 绝对不能进仓库
.env
.env.local

# 工具脚本的临时产物 / 截图预览
tools/.chrome-profile/
# ⚠️ 一次性探针脚本各自带一个 profile 后缀（-startup / -diag / -stack …），
#    只写 .chrome-profile/ 的话这些变体每次都会脏工作区，所以按前缀整体忽略。
tools/.chrome-profile*/
tools/.tmp-*.mjs
# ⚠️ 2026-09-25：tools/lib/loadSrc.mjs 加载 src 源码时，副本是**放在源码同目录**的
#    （放 tools/ 下会让源码里的相对 import 解析错位），掉进过 src/voice/.tmp-*.mjs。
#    正常情况下 finally 会删掉，只有进程崩溃才有残留 —— 那种痕迹不该脏工作区。
.tmp-*.mjs
tools/.dbg.mjs
*.log

# 打包产物
*.zip
dist-*/

# ---------------------------------------------------------------------------
# 本地临时产物
# ---------------------------------------------------------------------------
# 2026-09-24 第一次提交时漏进来过一堆：tmp/ 的中间文件、preview-site/ 下
# 重复的 12 套 GLB 模型、.synchk/ 的语法检查残留、.shots*/ 的截图、
# 以及 _rigdump*.txt / _autorig*.txt / _truth.txt 这类根目录级临时文本。
#
# ⚠️ 踩过的坑：`_*` 必须**不带斜杠**才同时匹配文件和目录。
#    写成 `_*/` 只匹配目录，_xxx.txt 这种照样会被提交进去。
#
# ⚠️ 一个要认下的副作用：这条会把 tools/_*.mjs 这类一次性探针脚本也排除。
#    它们只是开发过程产物（磁盘上还在，没删），不进仓库是刻意的。
# ---------------------------------------------------------------------------
_*

# ---------------------------------------------------------------------------
# 工作区记忆（.workbuddy/memory/ 下的每日日志与长期笔记）
# ---------------------------------------------------------------------------
# ⚠️ 2026-09-26：它是**过程记录**，不是源码，也不是临时缓存（不能删）。
#    每次动工程序都会追加，留着不进仓库最干净 —— 否则 git status 永远有一条
#    未跟踪目录，容易被误当成「有东西忘了提交」给 add 进去。
# ---------------------------------------------------------------------------
.workbuddy/

tmp/
preview-site/
.synchk/
.shots/
.shots-admin/
.shots-front/
